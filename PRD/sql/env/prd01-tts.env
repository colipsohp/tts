# prd01-tts.env — TTS 项目首次落地的 .env 增量配置清单
# 说明：只列本次「新增/调整」的配置项（键 = 示例值 + 注释），FAL_KEY 用 <placeholder>。
# 同步方式：把下面的键值合并到各环境 backend/.env，删除本文件头注释。
# ⚠️ 敏感字段（API key）绝不写真实值。

# ---- fal.ai ----
FAL_KEY=<placeholder>            # fal.ai API Key（必填；仅后端使用，绝不暴露前端）
FAL_MODEL=fal-ai/index-tts-2/text-to-speech   # 模型标识
FAL_REQUEST_TIMEOUT=300          # 生成总超时（秒）= 排队+推理全过程；Index TTS 2.0 推理可能 30~90s+
FAL_START_TIMEOUT=120            # 服务端开始处理前的排队超时（秒），不限制推理时长

# ---- 目录（相对项目根）----
OUTPUT_DIR=workplace/generated   # 生成音频输出目录
UPLOAD_DIR=workplace/uploads     # 自定义音色上传目录
VOICE_SCAN_DIR=assets/tone       # 内置音色扫描目录
DATABASE_URL=sqlite:///database/tts.db   # SQLite 数据库文件

# ---- 业务参数 ----
MAX_TEXT_LENGTH=2000             # 单次文案最大字数
TASK_POLL_INTERVAL=2             # 前端轮询间隔（秒）
STALE_TASK_TIMEOUT=3600          # running/pending 超时回收阈值（秒）
MAX_UPLOAD_SIZE=52428800         # 上传音频大小上限（字节，50MB）
RECENT_VOICE_COUNT=10            # 最近使用音色展示数量

# ---- 注意 ----
# 2026-08-27 修复：FAL_REQUEST_TIMEOUT 由 60 上调为 300（原值会导致 Index TTS 2.0
# 在排队/推理较慢时被客户端过早取消，报 "timed out after 60 seconds"）；
# 同时新增 FAL_START_TIMEOUT（排队等待上限）与总超时解耦。
