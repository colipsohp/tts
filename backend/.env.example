# ============================================
# TTS 后端配置示例 —— 复制为 .env 后填写 FAL_KEY
# cp .env.example .env   （Windows: copy .env.example .env）
# ⚠️ .env 含敏感信息，绝不提交到 git
# ============================================

# ---- fal.ai ----
# fal.ai API Key（必填；仅后端使用，绝不暴露前端）
FAL_KEY=<placeholder>
# 模型标识
FAL_MODEL=fal-ai/index-tts-2/text-to-speech
# 生成总超时（秒）：排队 + 推理全过程（Index TTS 2.0 推理可能 30~90s+）
FAL_REQUEST_TIMEOUT=300
# 服务端开始处理前的排队超时（秒），不限制推理时长
FAL_START_TIMEOUT=120

# ---- 目录（相对项目根）----
OUTPUT_DIR=workplace/generated
UPLOAD_DIR=workplace/uploads
VOICE_SCAN_DIR=assets/tone
DATABASE_URL=sqlite:///database/tts.db

# ---- 业务参数 ----
MAX_TEXT_LENGTH=2000
TASK_POLL_INTERVAL=2
STALE_TASK_TIMEOUT=3600
MAX_UPLOAD_SIZE=52428800
RECENT_VOICE_COUNT=10
